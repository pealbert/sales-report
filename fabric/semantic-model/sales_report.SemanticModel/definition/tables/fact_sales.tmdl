table fact_sales
	lineageTag: 57e1f5f4-cd91-46f5-8f48-79c3ed89f7d4
	sourceLineageTag: 1015fa3e-6825-478f-8a15-71de9151201e

	measure 'Avg Order Value' = DIVIDE([Total Revenue], [Total Orders], 0)
		lineageTag: 515511ec-febf-402f-85f5-7265a1267c24

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Quantity per Order' = DIVIDE(SUM(fact_sales[quantity]), DISTINCTCOUNT(fact_sales[order_id]))
		lineageTag: f7f37dbf-abda-46a9-b991-7b9497f87823

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Revenue per Order' = DIVIDE(SUM(fact_sales[revenue]),DISTINCTCOUNT(fact_sales[order_id]))
		lineageTag: 9d9d8846-b939-4426-9bd5-19920d6a1ef6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Customer Rank' =
			
			RANKX(
			    ALL(dim_customer[customer_name]),
			    [Total Revenue],
			    ,
			    DESC,
			    Dense
			)
		lineageTag: cf917a10-8b9b-438c-8e4e-9506d4ae693a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Customers' = DISTINCTCOUNT(dim_customer[customer_name])
		lineageTag: e0b7a344-9cb1-4537-8dd4-e0fcfc428d5a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Orders' = COUNTROWS(fact_sales)
		formatString: 0.00
		lineageTag: d2f3ddb3-ffea-47f8-a5bf-bbe2584ab79e

	measure 'Total Quantity Sold' = SUM(fact_sales[quantity])
		lineageTag: 3d0f5c65-9d8c-4b98-b8e7-f4c72d8b41d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Revenue' = SUM(fact_sales[revenue])
		lineageTag: 2d20cba2-ed73-4270-b4be-30adb6df4523

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Revenue ($USD)' = SUM(fact_sales[revenue_usd])
		lineageTag: 58d35ebc-4bea-4ff8-a075-3f1c88f8392f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

